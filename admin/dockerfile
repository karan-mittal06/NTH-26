FROM node:20.18.2-alpine3.21

WORKDIR /app

COPY package.json ./

RUN npm install

COPY . .

ARG NEXT_PUBLIC_BACKUP_TOKEN
ARG NEXT_PUBLIC_BACKEND_URL

ENV NEXT_PUBLIC_BACKUP_TOKEN=$NEXT_PUBLIC_BACKUP_TOKEN
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL

EXPOSE 4000

RUN npm run build

CMD ["npm", "run", "start"]
